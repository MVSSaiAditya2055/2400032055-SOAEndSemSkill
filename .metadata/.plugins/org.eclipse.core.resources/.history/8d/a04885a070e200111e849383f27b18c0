package soa.service;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.springframework.stereotype.Service;

import soa.model.Book;
import soa.repository.BookRepository;

@Service
public class TouristService {

	BookRepository BR;
	
	public BookService(BookRepository BR)
	{
		this.BR = BR;
	}
	
	//Add Book
	public Object addBook(Book B)
	{
		Map<String, Object> response = new HashMap<>();
		try
		{
			BR.save(B); //Insert Operation
			response.put("status", "success");
			response.put("message", "New book has been added");
		}catch(Exception e)
		{
			response.put("status", "error");
			response.put("message", e.getMessage());
		}
		return response;
	}
	
	//Get All books
	public Object getAllBooks()
	{
		Map<String, Object> response = new HashMap<>();
		try
		{
			List<Book> books = BR.findAll(); //READ ALL
			response.put("status", "success");
			response.put("books", books);
		}catch(Exception e)
		{
			response.put("status", "error");
			response.put("message", e.getMessage());
		}
		return response;
	}
	
	//Get Book by ID
	public Object getBookByID(Long id)
	{
		Map<String, Object> response = new HashMap<>();
		try
		{
			Book B = BR.findById(id).get();  //READ
			response.put("status", "success");
			response.put("book", B);
		}catch(Exception e)
		{
			response.put("status", "error");
			response.put("message", e.getMessage());
		}
		return response;
	}
	
	//Update Book
	public Object updateBook(Long id, Book B)
	{
		Map<String, Object> response = new HashMap<>();
		try
		{
			Book temp = BR.findById(id).get();
			temp.setTitle(B.getTitle());
			temp.setAuthor(B.getAuthor());
			temp.setIsbn(B.getIsbn());
			BR.save(temp); 		//SAVE THE CHANGES (UPDATE)
			
			response.put("status", "success");
			response.put("message", "Updated successfully");
		}catch(Exception e)
		{
			response.put("status", "error");
			response.put("message", e.getMessage());
		}
		return response;
	}
	
	//Delete Book
	public Object deleteBook(Long id)
	{
		Map<String, Object> response = new HashMap<>();
		try
		{
			BR.deleteById(id); //DELETE
			response.put("status", "success");
			response.put("message", "Deleted successfully");
		}catch(Exception e)
		{
			response.put("status", "error");
			response.put("message", e.getMessage());
		}
		return response;
	}
}
